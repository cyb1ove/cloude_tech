{
  "variant": 3,
  "region": "eu-central-1",
  "table_name_prefix": "cps-robot-arms",
  "billing_mode": "PAY_PER_REQUEST",
  "primary_key": {
    "partition_key": {"name": "RobotID", "type": "S"},
    "sort_key": {"name": "Timestamp", "type": "N"}
  },
  "global_secondary_index": {
    "index_name": "GSI_OperationalState_JointTorque",
    "partition_key": {"name": "OperationalState", "type": "S"},
    "sort_key": {"name": "JointTorqueNm", "type": "N"},
    "projection_type": "ALL"
  },
  "ttl_attribute": "ExpiresAt",
  "ttl_days": 30,

  "dataset": {
    "robots": 10,
    "readings_per_robot": 100,
    "interval_seconds": 60,
    "state_weights": {"IDLE": 0.90, "MOVING": 0.05, "ERROR": 0.05},
    "seed": 3
  },
  "benchmark": {
    "repetitions": 10,
    "query_robot": "ROBOT-03",
    "query_window_minutes": 30,
    "scan_state": "ERROR",
    "gsi_torque_threshold_nm": 13.5
  },

  "capacity_model": {
    "robots": 50,
    "sample_rate_hz": 1.0,
    "dashboard_queries_per_minute": 120,
    "peak_to_average": 4.0,
    "prices_usd_eu_central_1": {
      "on_demand_write_per_million": 0.7625,
      "on_demand_read_per_million": 0.1525,
      "provisioned_wcu_hour": 0.000793,
      "provisioned_rcu_hour": 0.0001586,
      "storage_gb_month": 0.306
    }
  },

  "tags": {"Project": "CyberPhysicalSystem", "Environment": "Laboratory", "Lab": "LB4-DynamoDB", "Owner": "Student-Variant-3"}
}
